# Gemini API key (GOOGLE_API_KEY also works).
GEMINI_API_KEY=
# PERSONA_MODEL=gemini-3.8-flash
# EVALUATOR_MODEL=gemini-pro-latest

# Modal: run `uv run modal token new` (writes ~/.modal.toml) or set these.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Pydantic AI Gateway (Logfire -> Gateway). Use the gateway root, not a route URL.
PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway-eu.pydantic.dev/proxy
PYDANTIC_AI_GATEWAY_API_KEY=
# Logfire project write token (project settings -> Write tokens); tracing is off without it.
LOGFIRE_TOKEN=
# Route persona agents through the Gateway's "modal" provider (Modal endpoint, vLLM):
# PERSONA_MODEL=gateway/modal:google/gemma-4-31B-it
