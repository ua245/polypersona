# --- Required ---------------------------------------------------------------
# Gemini API key, from https://aistudio.google.com/apikey (GOOGLE_API_KEY also works).
GEMINI_API_KEY=

# --- Required for the web app (API on Modal + UI) -----------------------------
# Signs login sessions and works as a master bearer token. Any long random string:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POLYPERSONA_TOKEN=
# Accounts that can sign in to the UI, as name:password pairs separated by commas.
POLYPERSONA_USERS=judge:change-me

# --- Optional ---------------------------------------------------------------
# PERSONA_MODEL=gemini-3.8-flash        # persona agents, persona generator, CSV personifier
# EVALUATOR_MODEL=gemini-pro-latest     # verdict and ask-the-evaluator

# Modal credentials normally live in ~/.modal.toml (`uv run modal token new`).
# Set these instead only in CI or on a machine without that file.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# --- Optional: Pydantic AI Gateway + Logfire (hackathon setup) ---------------
# Gateway root, not an endpoint URL; the endpoint name comes from the model string below.
# PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway-eu.pydantic.dev/proxy
# PYDANTIC_AI_GATEWAY_API_KEY=
# Logfire key with "Send telemetry" (or a project write token); tracing is off without it.
# LOGFIRE_TOKEN=
# Send model calls through Gateway endpoints ("gemini" is reserved by the Gateway, so don't use it):
# PERSONA_MODEL=gateway/persona:gemini-3.8-flash
# EVALUATOR_MODEL=gateway/evaluator:gemini-pro-latest
