# Gemini. GEMINI_API_KEY is used by the Modal Function runner; GOOGLE_API_KEY and GEMINI_MODEL by the sandbox runner.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=
# PERSONA_MODEL=gemini-3.8-flash
# EVALUATOR_MODEL=gemini-pro-latest

# Modal: run `uv run modal setup` (writes ~/.modal.toml) or set these.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
