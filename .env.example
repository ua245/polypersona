# Gemini API key (the code also accepts GEMINI_API_KEY and renames it).
GOOGLE_API_KEY=

# Optional model overrides, in Pydantic AI "provider:model" form.
# PERSONA_MODEL=google:gemini-3.8-flash      # persona agents
# EVALUATOR_MODEL=google:gemini-pro-latest   # evaluator and persona generator

# Modal auth comes from `uv run modal setup` (~/.modal.toml).
# With --modal, this .env is sent to the containers as a Modal Secret.
